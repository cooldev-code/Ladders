{
  "experimentalServices": {
    "frontend": {
      "root": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "routePrefix": "/api",
      "framework": "fastapi",
      "entrypoint": "app/main.py",
      "includeFiles": ["../data/feeds/**", "data/feeds/**"],
      "maxDuration": 60
    }
  }
}
